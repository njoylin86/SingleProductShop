

{%- if section.settings.background_image -%}
  <style>
    #hero-{{ section.id }}.aurora-hero-section { /* Targets this specific instance of the hero section */
      background-image: url('{{ section.settings.background_image | image_url: width: 1920, height: 1080 }}');
      background-size: cover;    /* Usually desired for hero images */
      background-position: right center; /* Usually desired for hero images */
      /* min-height: 100vh; /* You'll also want this, either here or in your global CSS for .aurora-hero-section */
      
      h1 {
        font-size: clamp(5rem, 13vw, 75px);
      }
      p {
        font-size: larger;
        margin: 0;
        color: var(--main-color);
        text-shadow: 1px -1px 3px #000000;
        padding-bottom: 15px;
      }
      .page-width {
        padding: 0px 4.5rem;
        z-index: 2;
        position: relative;
        max-width: 550px;
        margin: 0;
      }
      .hero-content {
        z-index: 2;
        position: relative;
        
        @media (max-width: 990px) {
          justify-content: flex-end;
          .positioner {
            padding: 40px 0px;
          }
          .positioner::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60%;
            background: linear-gradient(to top, rgba(0, 0, 0, 1), transparent);
            /* pointer-events: none; */
          }
        }
        
      }
      .cta-1, .cta-2 {    
        background: #2a2525a6;
        padding: 9px 10px;
        border-radius: 2px;
        outline: 1px solid #1c405f;
        color: #ffffff;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 900;
        text-decoration: unset;
        box-shadow: 1px 1px 4px -1px #554c4c;
        margin-right: calc(var(--standard_desk_marign) * 0.2);
        margin-bottom: 23px;
        display: inline-flex;
      }
      .cta-1 {
        background: #f9be00;
        color: #f50dbb8a;
        outline: 1px solid #f40dbaba;
        margin-right: 10px;
        align-items: center;
        gap: 0.5em; /* space between text and icon */
        text-decoration: none;
      }
      .cta-1:hover, .cta-2:hover {
        box-shadow: 3px 3px 3px 0px #554c4cad !important;
        outline: 2px solid #e31e3b !important;
      }
      .overlay {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background: rgba(0, 0, 0, 0.15); /* black with 50% opacity */
        z-index: 1;
      }
      .cta-1__icon {
        width: auto;
        height: 17px;
      }
    }
  </style>
<!--For mobile-->
  {% if section.settings.background_image_mobile %}
    <style>
      @media (max-width: 990px) {
        #hero-{{ section.id }}.aurora-hero-section {
          background-image: url('{{ section.settings.background_image_mobile | image_url: width: 1200 }}');
          background-position: right center;
          background-size: cover;
          background-repeat: no-repeat;
        }
      }
    </style>
  {% endif %}
{%- endif -%}

<section
  id="hero-{{ section.id }}"
  class="aurora-hero-section border-bottom"

  data-section-id="{{ section.id }}"
  data-section-type="aurora-hero"
>
<div class="overlay">&nbsp;</div>
  <div class ="hero-content align-vertically full-screen-height">
    <div class="positioner">
      <div class="page-width">
      {% if section.settings.headline != blank %}
        <h1 class="bebas-neue-regular">
          {{ section.settings.headline | escape }}
        </h1>
        {% endif %}
        {% if section.settings.subheadline != blank %}
          <div class="">
            {{ section.settings.subheadline }}
          </div>
        {% endif %}
        <div style="white-space: nowrap;">
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            <a class="cta-1" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label | escape }}
              <img src="https://cdn.shopify.com/s/files/1/0912/6356/6211/files/Namnlos_design_4.png?v=1755462133" 
                  alt="Cart icon" 
                  class="cta-1__icon"
                  width=""
                  height=""
                >
            </a>
          {% endif %}
          {% if section.settings.button_label2 != blank and section.settings.button_link2 != blank %}
            <a class="cta-2" href="{{ section.settings.button_link2 }}">
              {{ section.settings.button_label2 | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Aurora Hero",
  "tag": "section",
  "class": "aurora-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended size: 1920x1080px."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background Image Mobile",
      "info": "(mobile < 950px)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Sculpt Atmosphere."
    },
    {
      "type": "richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "<p>Introducing Aurora Light: a singular spotlight designed to transform your space with breathtaking prism effects and unparalleled ambient elegance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Köp nu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label2",
      "label": "Button Label2",
      "default": "Discover the Light"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Button Link2"
    }

  ],
  "presets": [
    {
      "name": "Aurora Hero"
    }
  ]
}
{% endschema %}