

{%- if section.settings.background_image -%}
  <style>
    #hero-{{ section.id }}.aurora-hero-section { /* Targets this specific instance of the hero section */
      background-image: url('{{ section.settings.background_image | image_url: width: 1920, height: 1080 }}');
      background-size: cover;    /* Usually desired for hero images */
      background-position: left; /* Usually desired for hero images */
      /* min-height: 100vh; /* You'll also want this, either here or in your global CSS for .aurora-hero-section */
      @media (max-width: 990px) {
        background-position: center;
      }
      h1 {
        font-size: clamp(5rem, 11vw, 127px);
        font-size: clamp(6rem, 13vw, 127px);
        color: var(--main-color);
      }
      p {
        font-size: larger;
        margin: 0;
        color: var(--main-color);
        text-shadow: 1px -1px 3px #000000;
        padding-bottom: 15px;
      }
      .star-rating-image img {
        margin-top: 20px;
        max-width: 100%;
        height: auto;
        display: block;
      }
      .page-width {
        padding: 0px 4.5rem;
        z-index: 2;
        position: relative;
      }
      .hero-content {
        z-index: 2;
        position: relative;

        @media (max-width: 990px) {
          justify-content: flex-end;
          .positioner {
            padding: 16px 0px;
          }
          .positioner::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60%;
            background: linear-gradient(to top, rgba(0, 0, 0, 1), transparent);
            /* pointer-events: none; */
          }
        }
      }
      .hero-content.full-screen-height {
        min-height: calc(100dvh - var(--header-offset) - 6px);
      }
      .cta-1, .cta-2 {    
        background: var(--main-color);
        padding: 8px 16px;
        border-radius: 2px;
        outline: 1px solid #ffffffbd;
        color: #151414;
        text-transform: uppercase;
        font-size: 12px;
        font-weight: 900;
        text-decoration: unset;
        box-shadow: 1px 1px 4px -1px #554c4c;
        box-shadow: 4px 4px 11px 5px #0000006b;
        margin-right: calc(var(--standard_desk_marign) * 0.2);
        display: inline-block;
        margin-bottom: 23px;
        text-shadow: 1px 1px #00000021;

      }
      .cta-1 {
        background: #f9be00;
        color: #f50dbbdb;
        outline: 2px solid #f40dbaba;
        margin-right: 10px;
        /*font-weight: 900;*/
        text-shadow: 1px 1px #0000005e;
      }
      .cta-1:hover, .cta-2:hover {
        box-shadow: 3px 3px 3px 0px #554c4cad !important;
        outline: 3px solid #f40dbaba !important;
      }
      .overlay {
        position: absolute;
        top: 0;
        left: 0;
        height: calc(100% - 6px);
        width: 100%;
        background: rgba(0, 0, 0, 0.3); /* black with 50% opacity */
        z-index: 1;
      }
    }

    .hero-bullets {
      list-style: none;
      padding: 0;
      margin: 16px 0 24px;
      font-size: 1.6rem;
      color: var(--main-color);
      font-weight: 700;
    }

    .custom-bullet {
      display: flex;
      align-items: center;  /* Vertikal centrering */
      margin-bottom: 0.6em;
    }

    .bullet-symbol {
      color: #f9be00;         /* Ändra till din accentfärg */
      font-size: 8px;
      margin-right: 8px;
      line-height: 1;
    }

    .bullet-text {
      line-height: 1.4;
    }

  </style>
{%- endif -%}

<section
  id="hero-{{ section.id }}"
  class="aurora-hero-section border-bottom"

  data-section-id="{{ section.id }}"
  data-section-type="aurora-hero"
>
<div class="overlay">&nbsp;</div>
  <div class ="hero-content align-vertically full-screen-height">
    <div class="positioner">
      <div class="page-width">
      {% if section.settings.headline != blank %}
        <h1 class="bebas-neue-regular">
          {{ section.settings.headline | escape }}
        </h1>
        {% endif %}
        {% if section.settings.subheadline != blank %}
          <div class="">
            {{ section.settings.subheadline }}
          </div>
        {% endif %}
        {% if section.settings.star_rating_image %}
          <div class="star-rating-image">
            <img 
              src="{{ section.settings.star_rating_image | image_url: width: 1000 }}" 
              alt="Star rating graphic" 
              loading="lazy"
            >
          </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <ul class="hero-bullets">
            {% for block in section.blocks %}
              <li class="custom-bullet"> <span class="bullet-symbol">◆</span> {{ block.settings.text }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        <div>
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            <a class="cta-1" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.button_label2 != blank and section.settings.button_link2 != blank %}
            <a class="cta-2" href="{{ section.settings.button_link2 }}">
              {{ section.settings.button_label2 | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Aurora Hero",
  "tag": "section",
  "class": "aurora-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended size: 1920x1080px."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Sculpt Atmosphere."
    },
    {
      "type": "richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "<p>Introducing Aurora Light: a singular spotlight designed to transform your space with breathtaking prism effects and unparalleled ambient elegance.</p>"
    },
    {
      "type": "image_picker",
      "id": "star_rating_image",
      "label": "Star rating image",
      "info": "Valfri bild som visas under subheadlinen, t.ex. betyg eller försäljningsdata."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Köp nu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label2",
      "label": "Button Label2",
      "default": "Discover the Light"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Button Link2"
    }

  ],
  "presets": [
    {
      "name": "Aurora Hero"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Punkttext",
          "default": "Skapar direkt en mysigare och mer inbjudande stämning"
        }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}